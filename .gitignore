# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
build/
dist/

# --- Generated / derived (NEVER results/raw, results/network, results/environment) ---
results/figures/*
!results/figures/.gitkeep
index.sqlite

# --- Transient orchestration-script working directories (verbose SSH/torchrun console
# output, incrementally-written per-repeat summaries) -- NOT a canonical data artifact.
# The canonical artifacts these directories feed are results/raw/*.json (aggregated,
# schema-valid RunResult records) and experiments/*/raw_step_telemetry*/*.json (clean
# per-step telemetry) -- both of those ARE committed. This one is scratch space the
# orchestration scripts write to and the aggregation scripts read from; see
# experiments/01_cu_grid/run_shaped_grid.py's own OUT_DIR.
experiments/*/shaped_grid_run_logs/
experiments/*/*_run_logs/

# --- Notebooks ---
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Claude Code harness-internal (session lock files, not project content) ---
.claude/scheduled_tasks.lock

# --- Secrets (defense in depth — see CLAUDE.md NFR-07, §23) ---
.env
*.pem
*.key
credentials.json
aws_credentials*

# NOTE: results/raw/, results/steps/, results/network/, results/environment/ are
# intentionally NOT ignored. They are append-only and committed on purpose
# (CLAUDE.md §16, ADR-004). Do not add them here.
